<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Connecting to and accepting connections from paired devices. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Saving received files to ~/Downloads/ECOnnector. -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<!-- Sending files the user picks, saving to a folder the user picks for received
	     files, and "Save to…" on the arrival card. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Remembering the chosen receive folder across restarts. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
</dict>
</plist>
